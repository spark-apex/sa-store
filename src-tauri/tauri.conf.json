{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "SA-Store",
    "version": "1.0.0",
    "identifier": "com.spark-apex.sa-store",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5180",
        "beforeDevCommand": "bun run dev",
        "beforeBuildCommand": "bun run build"
    },
    "app": {
        "windows": [
            {
                "title": "SA-Store",
                "label": "main",
                "width": 420,
                "height": 720,
                "minWidth": 380,
                "minHeight": 600,
                "resizable": true,
                "center": true,
                "decorations": false,
                "transparent": false,
                "visible": false,
                "backgroundColor": [
                    245,
                    246,
                    248,
                    255
                ]
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "nsis",
        "windows": {
            "nsis": {
                "installerIcon": "icons/icon.ico",
                "displayLanguageSelector": false,
                "languages": [
                    "SimpChinese",
                    "English"
                ],
                "installMode": "perMachine"
            }
        },
        "icon": [
            "icons/icon.png",
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}